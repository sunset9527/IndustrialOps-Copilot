# Copy to .env for Docker Compose. Values here are placeholders only.
INDUSTRIALOPS_DB_PASSWORD=change-me-app-password
INDUSTRIALOPS_DB_ROOT_PASSWORD=change-me-root-password
INDUSTRIALOPS_OFFLINE=true
INDUSTRIALOPS_PACKS_PATH=E:/private/industrialops/data/packs
INDUSTRIALOPS_BGE_MODEL_PATH=E:/huggingface/model
INDUSTRIALOPS_RERANKER_MODEL_PATH=E:/huggingface/bge-reranker-base

# Direct local-Python defaults. Docker Compose sets container-specific values itself.
INDUSTRIALOPS_API_PORT=8100
INDUSTRIALOPS_FRONTEND_PORT=5174
INDUSTRIALOPS_DATABASE_URL=mysql+pymysql://industrialops:change-me@localhost:3306/industrialops
INDUSTRIALOPS_REDIS_KEY_PREFIX=industrialops:
INDUSTRIALOPS_REQUEST_MAX_BYTES=26214400
INDUSTRIALOPS_AUTH_SESSION_TTL_SECONDS=3600
INDUSTRIALOPS_PACKS_ROOT=data/packs
INDUSTRIALOPS_PACK_REGISTRY_PATH=config/equipment_pack_registry_v1.json
INDUSTRIALOPS_INDEXES_ROOT=data/indexes
INDUSTRIALOPS_DEEPSEEK_API_KEY=
INDUSTRIALOPS_DEEPSEEK_BASE_URL=https://api.deepseek.com
INDUSTRIALOPS_DEEPSEEK_MODEL=deepseek-flash
INDUSTRIALOPS_DEEPSEEK_TIMEOUT=20
INDUSTRIALOPS_DEEPSEEK_MAX_TOKENS=1600
