# Local examples for IndustrialOps settings. Supply overrides through the process environment.
INDUSTRIALOPS_API_PORT=8100
INDUSTRIALOPS_FRONTEND_PORT=5174
INDUSTRIALOPS_DATABASE_URL=mysql+pymysql://industrialops:change-me@localhost:3306/industrialops
INDUSTRIALOPS_REDIS_KEY_PREFIX=industrialops:
INDUSTRIALOPS_REQUEST_MAX_BYTES=26214400
INDUSTRIALOPS_DEEPSEEK_API_KEY=
INDUSTRIALOPS_DEEPSEEK_BASE_URL=https://api.deepseek.com
INDUSTRIALOPS_DEEPSEEK_MODEL=deepseek-flash
INDUSTRIALOPS_DEEPSEEK_TIMEOUT=20
INDUSTRIALOPS_DEEPSEEK_MAX_TOKENS=1600
